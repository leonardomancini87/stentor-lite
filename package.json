    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "8.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "typescript": "6.0.3"
  }
