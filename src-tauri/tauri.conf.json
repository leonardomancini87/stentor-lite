{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sténtor Lite",
  "version": "0.9.0",
  "identifier": "it.tantanteatro.stentor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "regia",
        "title": "Sténtor Lite",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 800,
        "visible": false,
        "backgroundColor": "#f3f4f6",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NzYwNTNEMTlGQTkwRkMKUldUOGtQb1pQUVYyZG1LdVQ3dWhpUERiaFIwYVBvSFJiY01ncUh0dDFJMk9URW40cEpnZ0VETXEK",
      "endpoints": [
        "https://github.com/leonardomancini87/stentor-lite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Sopratitoli teatrali, semplici e multipiattaforma",
    "longDescription": "Sténtor Lite prepara, modifica e proietta sopratitoli per spettacoli dal vivo su macOS, Windows e Linux.",
    "copyright": "Copyright © 2026 Leonardo Mancini",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon-512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "EUPL-1.2",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "languages": [
          "English", "Italian", "French", "German", "Spanish", "SpanishInternational",
          "Portuguese", "PortugueseBR", "Dutch", "Swedish", "Norwegian", "Russian",
          "Ukrainian", "Bulgarian", "Turkish", "Arabic", "Japanese",
          "Korean", "SimpChinese", "TradChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
