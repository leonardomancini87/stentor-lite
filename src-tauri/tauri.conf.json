{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sténtor Lite",
  "version": "0.8.0",
  "identifier": "it.tantanteatro.stentor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "regia",
        "title": "Sténtor Lite",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 800,
        "maximized": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Sopratitoli teatrali, semplici e multipiattaforma",
    "longDescription": "Sténtor Lite prepara, modifica e proietta sopratitoli per spettacoli dal vivo su macOS, Windows e Linux.",
    "copyright": "Copyright © 2026 Leonardo Mancini",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon-512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "EUPL-1.2",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
