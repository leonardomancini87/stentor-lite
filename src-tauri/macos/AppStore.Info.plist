<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Voci aggiunte all'Info.plist solo nella copia per il Mac App Store.
  ITSAppUsesNonExemptEncryption = false: l'app non usa crittografia propria, quindi
  App Store Connect non chiede i documenti per l'esportazione a ogni invio.
-->
<plist version="1.0">
<dict>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
